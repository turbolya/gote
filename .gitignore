# dependencies
node_modules/

# Native projects — regenerated from app.json by `expo prebuild` (CNG).
/ios/
/android/

# Device build output (xcodebuild -derivedDataPath). Kept OUTSIDE /ios/ on
# purpose: RN's New Architecture pod post-install hook does `find ios -name
# Info.plist` and only skips lowercase "build/" — a capital "Build/" subdir
# under ios/ (e.g. the old ios/build-device) slips through and makes pod install
# choke on a compiled binary plist ("invalid byte sequence in UTF-8").
/build-device/

# Expo
.expo/
dist/

# Detox test artifacts (screenshots / logs from e2e runs)
artifacts/
web-build/
expo-env.d.ts

# Native
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# Detox (E2E) artifacts
artifacts/
.detox/

# macOS
.DS_Store

# Env
.env*.local
*.tmp
