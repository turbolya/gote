{
  "expo": {
    "name": "gote",
    "slug": "gote",
    "version": "2.24.3",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/gote-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#008AAC"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gote.app",
      "buildNumber": "3",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.gote.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#008AAC"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "gote uses your location only to find species typically observed near you. It is not stored or shared."
        }
      ],
      "@config-plugins/detox",
      [
        "@bacons/apple-targets",
        {
          "appleTeamId": "24M7W58WAU"
        }
      ]
    ],
    "extra": {
      "sentryDsn": "",
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.gote.app.watch.widget",
                  "targetName": "GoteWatchWidget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.gote.app"
                    ]
                  }
                },
                {
                  "bundleIdentifier": "com.gote.app.watch",
                  "targetName": "GoteWatch",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.gote.app"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "d6fc66db-3cfd-447d-aad1-166f4e5aad56"
      }
    },
    "owner": "tupakkas-team"
  }
}
