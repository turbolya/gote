{
  "expo": {
    "name": "gote",
    "slug": "gote",
    "version": "2.23.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/gote-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#008AAC"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gote.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.gote.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#008AAC"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "gote uses your location only to find species typically observed near you. It is not stored or shared."
        }
      ],
      "@config-plugins/detox",
      [
        "@bacons/apple-targets",
        {
          "appleTeamId": "24M7W58WAU"
        }
      ]
    ],
    "extra": {
      "sentryDsn": ""
    }
  }
}
