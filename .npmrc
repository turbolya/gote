# @config-plugins/detox 11 (latest) pins peer expo@^53, but this app is on
# Expo 54 — a strict install fails with ERESOLVE. The plugin works fine on 54;
# only its declared peer range is stale. Locally we passed --legacy-peer-deps by
# hand; declaring it here means clean installs (notably EAS Build's "Install
# dependencies" phase) resolve the same way instead of erroring out.
legacy-peer-deps=true
