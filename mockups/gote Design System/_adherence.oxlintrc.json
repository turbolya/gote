{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/buttons/**",
              "components/data-display/**",
              "components/quiz/**",
              "ui_kits/app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|tone|icon|iconRight|fullWidth|disabled|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, tone, icon, iconRight, fullWidth, disabled, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|success|danger|tinted|outline)$/]",
        "message": "<Button> variant must be one of 'primary' | 'success' | 'danger' | 'tinted' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|orange)$/]",
        "message": "<Button> tone must be one of 'primary' | 'orange'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChoiceButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|disabled|children|onClick|key|ref|className|style|children)$/]",
        "message": "<ChoiceButton> doesn't accept that prop. Declared props: state, disabled, children, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChoiceButton'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:default|correct|wrong)$/]",
        "message": "<ChoiceButton> state must be one of 'default' | 'correct' | 'wrong'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|variant|size|iconSize|color|disabled|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, variant, size, iconSize, color, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:faint|photo|brand)$/]",
        "message": "<IconButton> variant must be one of 'faint' | 'photo' | 'brand'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|accent|title|sub|trailing|divider|onClick|key|ref|className|style|children)$/]",
        "message": "<ListRow> doesn't accept that prop. Declared props: icon, accent, title, sub, trailing, divider, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListRow'] > JSXAttribute[name.name='accent'] > Literal[value!=/^(?:green|blue|violet|amber|teal|indigo|rose|slate)$/]",
        "message": "<ListRow> accent must be one of 'green' | 'blue' | 'violet' | 'amber' | 'teal' | 'indigo' | 'rose' | 'slate'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onPhoto|key|ref|className|style|children)$/]",
        "message": "<ProgressBar> doesn't accept that prop. Declared props: value, onPhoto."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<SectionLabel> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|children|onBrand|key|ref|className|style|children)$/]",
        "message": "<StatPill> doesn't accept that prop. Declared props: icon, children, onBrand."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "Button": {
        "replaces": []
